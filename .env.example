# Career-Ops environment configuration. Copy to .env.local (already gitignored) and fill in real
# values there — never commit real secrets. See src/lib/ai/provider.ts for how these are read.

# AI (Enrich with AI) — all three required together to enable any AI feature; omitting any one of
# them leaves AI fully disabled, which is the safe default.
CAREER_OPS_AI_ENABLED=false
CAREER_OPS_AI_PROVIDER=openai
OPENAI_API_KEY=

# JobDiva job-discovery connector (src/lib/ats/jobdiva.ts). Both are required together; with either
# missing the connector fails closed with a configuration error and makes no outbound request. Leave
# blank unless you have JobDiva portal credentials — every other ATS connector is unauthenticated.
JOBDIVA_API_USERNAME=
JOBDIVA_API_PASSWORD=
